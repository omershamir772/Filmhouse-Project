# Copy to .env (never commit it) or set these in your host's environment settings.
# Only the first block is needed for local development; production needs all of them.

# --- Local development (all optional) ---
PORT=3000
# DATABASE_URL=postgres://user:pass@localhost:5432/filmhouse   # default: built-in PGlite in ./data
# UPLOAD_DIR=uploads

# --- Production (required) ---
NODE_ENV=production
APP_URL=https://filmhouse.example
APP_SECRET=                      # 32+ random characters: openssl rand -hex 32
DATABASE_URL=
TRUST_PROXY=2                    # 1 = Render only, 2 = Cloudflare proxy + Render
RESEND_API_KEY=
EMAIL_FROM=FilmHouse <hello@filmhouse.example>
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=filmhouse-photos
R2_PUBLIC_URL=https://media.filmhouse.example

# --- Optional ---
SENTRY_DSN=
BETA_INVITE_CODES=               # comma separated; empty = open sign-up
MIN_AGE=18
READ_ONLY=0                      # 1 = emergency read-only mode
CHECK_BREACHED_PASSWORDS=1       # defaults to on in production
