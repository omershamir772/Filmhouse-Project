<figure class="polaroid">
  <a href="<%= mediaUrl(photo.image_key) %>" target="_blank" rel="noopener"><img src="<%= mediaUrl(photo.thumb_key) %>" alt="<%= photo.caption || 'Behind-the-scenes photo' %>" loading="lazy" width="480" height="480"></a>
  <figcaption>
    <% if (photo.caption) { %><span class="caption"><%= photo.caption %></span><% } %>
    <span class="small muted">
      <% if (photo.username) { %><a href="/u/<%= photo.username %>"><%= photo.display_name %></a><% } %>
      <% if (photo.film_title) { %> on set of <a href="/films/<%= photo.film_id %>"><em><%= photo.film_title %></em></a><% } %>
      · <%= timeAgo(photo.created_at) %>
      <% if (currentUser && currentUser.id !== photo.author_id) { %> · <a href="/report?type=photo&amp;id=<%= photo.id %>">Report</a><% } %>
    </span>
  </figcaption>
</figure>
