    "seed": "node scripts/seed.js",
    "make-admin": "node scripts/make-admin.js",
    "test": "node --test --test-concurrency=1 'test/**/*.test.js'"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1161.0",
    "@electric-sql/pglite": "^0.5.13",
    "@sentry/node": "^11.10.0",
    "ejs": "^7.0.2",
    "express": "^5.3.0",
    "helmet": "^8.3.0",
    "multer": "^2.5.0",
    "pg": "^8.23.1",
    "sharp": "^0.35.5"
  }
}
