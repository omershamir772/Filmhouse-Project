{
  "name": "filmhouse",
  "version": "0.1.0",
  "private": true,
  "description": "FilmHouse — a networking and portfolio platform for film students, independent filmmakers and institutions.",
  "main": "src/server.js",
  "engines": {
    "node": ">=22.13"
  },
  "scripts": {
    "start": "node src/server.js",
    "dev": "node --watch src/server.js",
